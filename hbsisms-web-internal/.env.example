# mock = data giả | http = gọi API thật (OTP Firebase cần http)
VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Hybrid (khi VITE_API_MODE=mock): CSV prefix path đi HTTP
# VITE_API_HTTP_PATHS=/auth,/orders,/sales-requests,/payments,/pricing,/customers

# Cùng Firebase project với external; mở http://127.0.0.1:5180
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Goong Maptiles (map UI). Geocode = GOONG_API_KEY ở hbsisms-api/.env
# VITE_GOONG_MAPTILES_KEY=
