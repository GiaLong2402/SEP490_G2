# mock: chạy bằng dữ liệu giả lập trong trình duyệt | http: gọi backend thật
# OTP Firebase cần VITE_API_MODE=http
VITE_API_MODE=mock
# Chỉ dùng khi VITE_API_MODE=http hoặc hybrid (VITE_API_HTTP_PATHS)
VITE_API_BASE_URL=http://localhost:8081/api/v1

# Hybrid gắn dần (khi VITE_API_MODE=mock): CSV prefix path đi HTTP, còn lại mock.
# Sales Inter 2 — không gồm /pos (chưa có BE PosController):
# VITE_API_HTTP_PATHS=/auth,/orders,/sales-requests,/payments,/pricing,/customers

# Phase 3 — Firebase Phone Auth (cùng project với external; để trống = stub)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Goong Maptiles key (map UI). Geocode dùng GOONG_API_KEY ở hbsisms-api/.env
# VITE_GOONG_MAPTILES_KEY=
