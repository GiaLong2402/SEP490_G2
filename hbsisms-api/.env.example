# Copy to .env (git-ignored). Spring Boot reads it on startup.
DB_URL=jdbc:postgresql://localhost:5432/hbsisms
DB_USERNAME=postgres
DB_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_TTL=PT8H

CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173

# Only used on first start, when the database has no user yet.
SEED_ADMIN_PASSWORD=change-me-too

# Swagger UI at /api/v1/swagger-ui.html — set false in production
SWAGGER_ENABLED=true

# update (dev) | validate (prod)
JPA_DDL_AUTO=update

# OTP login (Inter 2): stub = "stub.<uid>.<phone>"; firebase = Admin SDK verifyIdToken
FIREBASE_AUTH_MODE=stub
# Required when FIREBASE_AUTH_MODE=firebase (or set GOOGLE_APPLICATION_CREDENTIALS)
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# true (default local): every role may POST /auth/login. false (prod): only admin; others use OTP.
AUTH_PASSWORD_LOGIN_ALL_ROLES=true

# PayOS (task #32) — keys from https://my.payos.vn (sandbox). Docs: https://payos.vn/docs/api/
# mode: off | sandbox | live. Leave keys empty when mode=off.
PAYOS_MODE=off
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua
PAYOS_CANCEL_URL=http://localhost:5173/thanh-toan/ket-qua
