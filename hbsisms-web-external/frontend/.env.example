# Copy to .env (không commit .env)
# Path tương đối → Vite proxy → Spring Boot :8080
VITE_API_BASE_URL=/api/v1

# Firebase Phone Auth — lấy từ Console → Project settings → Your apps (Web)
# Console → Authentication → Settings → Authorized domains: thêm 127.0.0.1
# Mở app bằng http://127.0.0.1:5173 (không lẫn localhost)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# Goong Maptiles (hiển thị map). Geocode/reverse = GOONG_API_KEY ở hbsisms-api/.env
# VITE_GOONG_MAPTILES_KEY=
